# Single value every file reads. File database, one writer at a time.
DB_CONN=duckdb:///data/warehouse.duckdb

# MLflow: a local server owns the sqlite store and the artifact folder.
# Clients only talk to MLFLOW_TRACKING_URI (logging straight to sqlite writes to ./mlruns).
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACTS_DESTINATION=./mlartifacts
MLFLOW_TRACKING_URI=http://127.0.0.1:5001

# Every port is bound to the loopback address only. 5000 is taken by macOS AirPlay Receiver.
MLFLOW_HOST=127.0.0.1
MLFLOW_PORT=5001
API_HOST=127.0.0.1
API_PORT=8000

# Turns off dbt's anonymous usage tracking.
DBT_SEND_ANONYMOUS_USAGE_STATS=false

# Model loading (ADR 8). Comma-separated list of extra types the safe model format may load.
MODEL_TRUSTED_TYPES=sklearn.tree._tree.Tree

# Served and evaluated model: always the alias, never a version number or "latest".
MODEL_URI=models:/taxi-duration@champion
# SHA-256 pinned for the registered version (the hash includes the version, ADR 8 point 20).
# Print it with make register or uv run python -m taxi_duration.verify_model models:/taxi-duration@champion.
# Leave empty here; put the real value only in your own .env.
MODEL_SHA256=
